# Olander droplet edge — TLS termination + reverse proxy.
#
# OLANDER_DOMAIN is set via systemd drop-in (/etc/systemd/system/caddy.service.d/override.conf)
# written by install.sh. Validate locally with:
#   OLANDER_DOMAIN=<agent-domain> caddy validate --config Caddyfile --adapter caddyfile

egress.{$OLANDER_DOMAIN} {
	# /health and /proxy/* are the public surfaces. Bearer-token checks happen
	# inside the upstream services; Caddy forwards Authorization untouched
	# (default reverse_proxy behavior).
	@health path /health
	handle @health {
		reverse_proxy 127.0.0.1:8088
	}

	@proxy path /proxy/*
	handle @proxy {
		reverse_proxy 127.0.0.1:8089
	}

	# Everything else gets a flat 404 — don't leak that anything is here.
	handle {
		respond "not found" 404
	}

	encode gzip

	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 3
		}
		format json
	}
}

# Caddy auto-redirects :80 → :443 by default for any site declared above.
# It also handles ACME HTTP-01 challenges on :80 internally before the redirect.
