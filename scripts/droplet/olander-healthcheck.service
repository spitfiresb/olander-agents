[Unit]
Description=Olander P21 egress healthcheck (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Both env files are optional — the script gracefully skips checks whose env
# vars aren't set. olander-health.env supplies OLANDER_DOMAIN (TLS check);
# olander-proxy.env supplies OLANDER_PROXY_TOKEN (proxy /healthz check).
EnvironmentFile=-/etc/olander-health.env
EnvironmentFile=-/etc/olander-proxy.env
ExecStart=/usr/local/bin/olander-healthcheck.sh
User=root
