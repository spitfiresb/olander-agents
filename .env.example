# Copy to .env.local and fill in values. .env.local is gitignored.
# Note: this is the app (Vercel) environment. The P21_* credentials and
# OLANDER_PROXY_TOKEN live on the egress droplet, not here — see
# scripts/droplet/install.sh and docs/Droplet.md.

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Microsoft Entra (Azure AD) OAuth provider
# ISSUER controls which accounts can sign in:
#   - Multi-tenant (any Entra account): https://login.microsoftonline.com/common/v2.0/
#   - Single-tenant (one org only):     https://login.microsoftonline.com/<TENANT_ID>/v2.0/
# Who can sign in is controlled per-email in /admin (the `member` table, a DB
# allowlist) plus AUTH_BOOTSTRAP_ADMINS below — not by email domain.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Comma-separated Entra tenant GUIDs allowed to sign in. The `tid` claim is
# bound to Microsoft's per-tenant signing key; `email` is not (a foreign tenant
# admin can set their user's mail attribute to any string, including
# user@olander.com). The `tid` check is the cryptographic boundary that runs
# before the per-email allowlist is even consulted. Login fails closed if this
# is unset. Discover via:
#   curl https://login.microsoftonline.com/<domain>/.well-known/openid-configuration
# and pull the GUID out of `issuer`.
AUTH_ALLOWED_TENANT_IDS=

# Comma-separated emails that are always allowed to sign in and always get the
# admin tier, independent of the `member` table — first-admin bootstrap, and
# break-glass if the table ends up with no admins. The `tid` check above still
# applies. Keep this to 1-2 trusted accounts; can be left unset once the seeded
# admins exist (the migration seeds the project owners).
AUTH_BOOTSTRAP_ADMINS=

# Neon Postgres app DB (pooled connection string)
DATABASE_URL=

# Direct (unpooled) connection string, used only by drizzle.config.ts for
# migrations — the pooler rejects some DDL/prepared-statement work (docs/db.md).
# Optional: falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=

# Chat model provider (Vercel AI SDK). Server-only — never sent to the browser.
#
# AI_PROVIDER selects the chat backend: "anthropic" (default), "openai", or
# "google". Leave unset/anthropic to keep Claude. Set to "openai" or "google"
# to run a cheaper model — only that provider's API key is then required;
# everything else is wired in code (lib/ai/model.ts). Lets you A/B a cheaper
# model behind one env var.
AI_PROVIDER=anthropic

# Anthropic — used when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — used when AI_PROVIDER=openai. Defaults to gpt-5-mini if OPENAI_MODEL
# is unset. Key from https://platform.openai.com/api-keys (starts with "sk-").
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google — used when AI_PROVIDER=google. Defaults to gemini-2.5-flash if
# GOOGLE_MODEL is unset; override with gemini-2.5-flash-lite for the cheaper
# tier. Like gpt-4.1-mini, non-gated (no org/KYC verification).
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Voyage AI (direct API). Used by:
#   - searchCatalog tool        → voyage-4-lite for queries
#   - scripts/backfill-catalog  → voyage-4-large for documents
#   - /api/cron/sync-catalog    → voyage-4-large for incremental updates
# Both models share Voyage 4's 1024-dim space, so document and query vectors
# are directly comparable in pgvector. The first 200M tokens are free per
# account across the family — covers Olander's catalog for years.
VOYAGE_API_KEY=

# Vercel cron auth. Vercel signs every cron request with this token; we
# verify it in /api/cron/sync-catalog before doing any work. Generate with:
#   openssl rand -base64 32
# Without this set, the endpoint always 401s (intentional — keeps the embed
# budget from being a public endpoint).
CRON_SECRET=

# Qdrant Cloud — holds the catalog vector collection. See docs/Vector_Store.md
# for the wire contract, and docs/RETRIEVAL.md § Vector store for why this lives
# outside Neon. Collection is 1024d cosine, AWS us-west-1 (Northern
# California), default name 'olander-catalog'. Set QDRANT_COLLECTION if you
# want a different name (e.g. for a staging env). URL looks like
# https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=olander-catalog

# Second collection, holding chunks of uploaded reference documents (the RAG
# document store) rather than catalog items. Defaults to 'olander-docs'.
QDRANT_DOCS_COLLECTION=olander-docs

# Dev override (Stage 4): when true, /api/chat allows unauthenticated requests.
# Honored only outside production. Leave blank for prod.
ALLOW_UNAUTHED_DEV=

# P21 egress droplet — health endpoint consumed by /status.
# URL is printed at the end of `OLANDER_DOMAIN=... bash scripts/droplet/install.sh`
# on the droplet (e.g. https://<egress-host>/health). Token is
# generated on first install and stored in /etc/olander-health.env.
# If unset, /status shows "not configured" for the P21 service (no error).
DROPLET_HEALTH_URL=
DROPLET_HEALTH_TOKEN=

# P21 egress droplet — Layer 2 proxy (Caddy /proxy/* → loopback :8089).
# URL + token are printed at the end of the same install.sh run; token is
# stored in /etc/olander-proxy.env. The /api/chat tool layer fetches
# `${DROPLET_PROXY_URL}/proxy/<endpoint>` with `Authorization: Bearer ${TOKEN}`.
DROPLET_PROXY_URL=
DROPLET_PROXY_TOKEN=

# Vercel Blob — chat attachments storage (chat-attachments/{userId}/...).
# Vercel auto-injects this when a Blob store is linked to the project; locally,
# pull it from the Vercel dashboard if you want to test uploads end-to-end.
# Without it, /api/uploads will 500.
BLOB_READ_WRITE_TOKEN=
