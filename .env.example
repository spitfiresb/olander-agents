# Copy to .env.local and fill in values. .env.local is gitignored.
# Provision-side work (Neon project, Microsoft Entra app registration) is still pending.

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Microsoft Entra (Azure AD) OAuth provider
# ISSUER controls which accounts can sign in:
#   - Multi-tenant (any Entra account): https://login.microsoftonline.com/common/v2.0/
#   - Single-tenant (one org only):     https://login.microsoftonline.com/<TENANT_ID>/v2.0/
# Domain restrictions (e.g., @olander.com only) are enforced in code, not here.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Neon Postgres app DB (pooled connection string)
DATABASE_URL=

# Anthropic (Vercel AI SDK). Server-only — never sent to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Dev override (Stage 4): when true, /api/chat allows unauthenticated requests.
# Honored only outside production. Leave blank for prod.
ALLOW_UNAUTHED_DEV=

# P21 egress droplet — health endpoint consumed by /status.
# URL is printed at the end of `OLANDER_DOMAIN=... bash scripts/droplet/install.sh`
# on the droplet (e.g. https://<egress-host>/health). Token is
# generated on first install and stored in /etc/olander-health.env.
# If unset, /status shows "not configured" for the P21 service (no error).
DROPLET_HEALTH_URL=
DROPLET_HEALTH_TOKEN=
